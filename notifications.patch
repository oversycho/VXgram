diff -ruN -x .git a/vxgram/frontend/vxgram/test/notification_model_test.dart b/vxgram/frontend/vxgram/test/notification_model_test.dart
--- a/vxgram/frontend/vxgram/test/notification_model_test.dart	1970-01-01 00:00:00.000000000 +0000
+++ b/vxgram/frontend/vxgram/test/notification_model_test.dart	2026-10-12 09:43:44.345520903 +0000
@@ -0,0 +1,27 @@
+import 'package:flutter_test/flutter_test.dart';
+import 'package:vxgram/features/notifications/data/models/notification_model.dart';
+import 'package:vxgram/features/notifications/domain/app_notification.dart';
+
+void main() {
+  Map<String, dynamic> row(String type, {bool read = false}) => {
+        'id': 'n1', 'type': type, 'actor_id': 'u2', 'actor_username': 'ana', 'actor_avatar': null, 'post_id': 'p1',
+        'thumb_url': 'https://x/t.jpg', 'body': 'nice', 'is_read': read, 'created_at': '2026-01-01T00:00:00Z',
+      };
+
+  test('every backend type maps to an enum value; unknown types do not crash', () {
+    expect(NotificationModel.fromJson(row('like')).type, NotificationType.like);
+    expect(NotificationModel.fromJson(row('comment')).type, NotificationType.comment);
+    expect(NotificationModel.fromJson(row('follow')).type, NotificationType.follow);
+    expect(NotificationModel.fromJson(row('follow_request')).type, NotificationType.followRequest);
+    expect(NotificationModel.fromJson(row('follow_accepted')).type, NotificationType.followAccepted);
+    expect(NotificationModel.fromJson(row('something_new')).type, NotificationType.other);
+  });
+
+  test('fields are mapped', () {
+    final n = NotificationModel.fromJson(row('comment', read: true));
+    expect(n.actorUsername, 'ana');
+    expect(n.body, 'nice');
+    expect(n.thumbUrl, 'https://x/t.jpg');
+    expect(n.read, isTrue);
+  });
+}
diff -ruN -x .git a/vxgram/frontend/vxgram/test/notifications_cubit_test.dart b/vxgram/frontend/vxgram/test/notifications_cubit_test.dart
--- a/vxgram/frontend/vxgram/test/notifications_cubit_test.dart	1970-01-01 00:00:00.000000000 +0000
+++ b/vxgram/frontend/vxgram/test/notifications_cubit_test.dart	2026-10-12 09:43:44.345529742 +0000
@@ -0,0 +1,41 @@
+import 'package:flutter_test/flutter_test.dart';
+import 'package:vxgram/features/notifications/bloc/notifications_cubit.dart';
+import 'package:vxgram/features/notifications/domain/app_notification.dart';
+import 'fakes/fake_repositories.dart';
+
+void main() {
+  test('load lists the items, marks everything read and clears the badge; items keep their unread flag', () async {
+    final repo = FakeNotificationRepository(items: [fakeNotification('1'), fakeNotification('2', read: true)], unread: 1);
+    var cleared = 0;
+    final cubit = NotificationsCubit(repo, FakeProfileRepository(), onMarkedRead: () => cleared++);
+    await cubit.load();
+    expect(cubit.state.status, NotificationsStatus.success);
+    expect(cubit.state.items.length, 2);
+    expect(cubit.state.items.first.read, isFalse); // still highlighted in this session
+    expect(repo.markedRead, isTrue);
+    expect(cleared, 1);
+    await cubit.close();
+  });
+
+  test('confirming a follow request tells the server and removes the row', () async {
+    final profiles = FakeProfileRepository();
+    final req = fakeNotification('7', type: NotificationType.followRequest, actor: 'u9');
+    final cubit = NotificationsCubit(FakeNotificationRepository(items: [req, fakeNotification('8')]), profiles);
+    await cubit.load();
+    await cubit.respond(req, accept: true);
+    expect(profiles.responded, ['u9:true']);
+    expect(cubit.state.items.map((n) => n.id), ['8']);
+    await cubit.close();
+  });
+
+  test('deleting a follow request sends accept: false', () async {
+    final profiles = FakeProfileRepository();
+    final req = fakeNotification('7', type: NotificationType.followRequest, actor: 'u9');
+    final cubit = NotificationsCubit(FakeNotificationRepository(items: [req]), profiles);
+    await cubit.load();
+    await cubit.respond(req, accept: false);
+    expect(profiles.responded, ['u9:false']);
+    expect(cubit.state.items, isEmpty);
+    await cubit.close();
+  });
+}
diff -ruN -x .git a/vxgram/frontend/vxgram/test/unread_cubit_test.dart b/vxgram/frontend/vxgram/test/unread_cubit_test.dart
--- a/vxgram/frontend/vxgram/test/unread_cubit_test.dart	1970-01-01 00:00:00.000000000 +0000
+++ b/vxgram/frontend/vxgram/test/unread_cubit_test.dart	2026-10-12 09:43:44.345540510 +0000
@@ -0,0 +1,25 @@
+import 'package:flutter_test/flutter_test.dart';
+import 'package:vxgram/features/notifications/bloc/unread_cubit.dart';
+import 'fakes/fake_repositories.dart';
+
+void main() {
+  test('refresh reads the unread count, clear resets it', () async {
+    final cubit = UnreadCubit(FakeNotificationRepository(unread: 4));
+    await cubit.refresh();
+    expect(cubit.state, 4);
+    cubit.clear();
+    expect(cubit.state, 0);
+    await cubit.close();
+  });
+
+  test('start polls the server; stop (logout) resets to 0', () async {
+    final repo = FakeNotificationRepository(unread: 2);
+    final cubit = UnreadCubit(repo, interval: const Duration(milliseconds: 5))..start();
+    await cubit.stream.firstWhere((n) => n == 2);
+    repo.unread = 5;
+    await cubit.stream.firstWhere((n) => n == 5);
+    cubit.stop();
+    expect(cubit.state, 0);
+    await cubit.close();
+  });
+}
